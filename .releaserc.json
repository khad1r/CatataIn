{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/catetin-windows-x64.zip",
            "label": "Catetin Windows (x64) Standalone Executable"
          },
          {
            "path": "dist/catetin-linux-x64.tar.gz",
            "label": "Catetin Linux (x64) Standalone Binary"
          },
          {
            "path": "dist/catetin-wasm.zip",
            "label": "Catetin WebAssembly Package"
          }
        ]
      }
    ]
  ]
}
